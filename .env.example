# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Owner allowlist (server-only). When set, only this email can use the
# portal, even if another account exists in Supabase Auth.
PORTAL_OWNER_EMAIL=

# Google OAuth web client ID (server-only, same one saved in Supabase's
# Google provider). When set, Google sign-in returns to /auth/google on the
# portal's domain, so Google's screen names the portal rather than the
# Supabase project URL. Add https://<portal-domain>/auth/google to the
# client's Authorized redirect URIs first.
GOOGLE_CLIENT_ID=

# Demo mode: set to 1 to run on the bundled seed data with no backend.
# Only takes effect when the Supabase vars above are empty. Leave unset
# in production unless you deliberately want the seed UI.
NEXT_PUBLIC_PORTAL_DEMO=

# TREK trip planner on the home PC, served over Tailscale (server-only).
# Paste the https://<pc>.<tailnet>.ts.net address from `tailscale serve`.
# It only opens on devices signed in to the tailnet. Leave empty to hide
# the "Open TREK" button on /trips.
TREK_URL=
